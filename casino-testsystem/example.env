# ==========================================
# Globale Konfiguration (Beispiel)
# Diese Datei nach .env kopieren und anpassen
# ==========================================

# ------------------
# Backend
# ------------------

# PostgreSQL-Verbindung
# Format:
# postgresql://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE

# Port des Express-Servers
PORT=3000

# Erlaubte Frontend-URL (CORS)
FRONTEND_URL=http://localhost:5173

# Laufzeitumgebung
# Werte: development | production
NODE_ENV=development

# ------------------
# Frontend
# ------------------

# URL des Backends
# Lokal:
# http://localhost:3000
# Produktion:
# https://dein-backend.onrender.com
VITE_API_URL=http://localhost:3000