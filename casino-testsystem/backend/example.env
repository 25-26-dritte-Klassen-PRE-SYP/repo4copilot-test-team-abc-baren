# Beispielkonfiguration fuer lokale Entwicklung
# Diese Datei nicht direkt verwenden.
# In .env kopieren und Werte anpassen.
#
# Render Produktion (Backend):
# DATABASE_URL = Internal Database URL von Render PostgreSQL
# NODE_ENV = production
# FRONTEND_URL = https://DEIN-FRONTEND.onrender.com

DATABASE_URL=postgresql://USER:PASSWORT@localhost:5432/DEINE_DB
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
